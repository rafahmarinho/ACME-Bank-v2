# ---------------------------------------------------------------------------
# ACME Bank — environment variables
# Copy to .env.local for local development. Configure the same keys in Vercel.
# ---------------------------------------------------------------------------

# Supabase project URL (local CLI default for this project: http://127.0.0.1:55421)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421

# Publishable (client-safe) key — `supabase status` or Dashboard › Project Settings › API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — server only (seed script, demo reset, API). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the web app (used for password reset e-mail links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password assigned to every demo user created by `pnpm db:seed` and the demo reset
DEMO_PASSWORD=AcmeDemo!2026
